# Dependencies
node_modules/

# Build outputs
dist/
dist-bundle/
dist-app/
build/
# ただし electron-builder のアイコン等のソース資産は追跡する
!electron/build/
!electron/build/**
*.tsbuildinfo

# Isolated vendor install for distribution packaging
# (package-lock.json is committed for reproducible npm ci builds)
backend/vendor/node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp

# Whisper / Ollama models (large binaries)
*.bin
*.gguf
models/

# Audio temp files
*.wav
*.webm
*.opus
*.mp3

# whisper.cpp build artifacts
whisper.cpp/

# electron-ollama runtime cache (dev では repo 直下に作られる)
electron-ollama/

# 配布同梱用に prep スクリプトが用意する大容量バンドル(Llama blobs/manifests 等)
electron/build-resources/

# Claude Code のエージェント用 worktree(リポジトリ内に作られるため)
.claude/worktrees/
