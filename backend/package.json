{
  "name": "backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-bundle/index.cjs --external:nodejs-whisper --external:fsevents",
    "prep:vendor": "cd vendor && rm -rf node_modules && npm ci --omit=dev --no-fund --no-audit --silent",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^2.1.1",
    "nodejs-whisper": "^0.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.16.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2"
  }
}
